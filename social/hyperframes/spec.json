 "segments": [
  {"wav": "assets/vo/s0.wav", "vo": "People hear \"let go\", and think it means: sit back and wait. It doesn't.", "speech": [0.05, 4.28], "pauses": [[2.23, 2.57], [3.58, 3.84]]},
  {"wav": "assets/vo/s1.wav", "vo": "Letting go means dropping the assumptions you don't need.", "speech": [0.05, 3.45], "pauses": [[1.07, 1.37]]},
  {"wav": "assets/vo/s2.wav", "vo": "Don't fear the change. Doing nothing still moves everything around you.", "speech": [0.05, 4.27], "pauses": [[1.37, 1.79]]},
  {"wav": "assets/vo/s3.wav", "vo": "And then you act. You build a reality you'd at least want to live in. Open hands. Still moving.", "speech": [0.05, 6.1], "pauses": [[0.98, 1.40], [3.74, 4.22]]}
 ],
 "points": [
  {"img": "a4_douse.jpg", "en": "Drop the assumptions you don't need", "lv": "Atmet liekos pieņēmumus"},
  {"img": "a4_swim.jpg", "en": "Doing nothing still moves the field", "lv": "Arī nedarīšana maina lauku"},
  {"img": "a4_whisk.jpg", "en": "Then act. Open hands, still moving", "lv": "Tad dari. Atvērtas rokas, kustībā"}
 ],
